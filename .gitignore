# --- Data -------------------------------------------------------------------
# Corpora are downloaded by scripts/data/, never committed. See
# docs/reports/01_reconnaissance.md for provenance and checksums.
# NOTE: the leading slash is load-bearing -- a bare `data/` would also ignore
# docs/reports/data/, which holds committed benchmark evidence.
/data/
*.zip
*.bin
*.npy

# --- Training artifacts -----------------------------------------------------
# Per-run logs and checkpoints are bulky and are NOT committed. Curated evidence
# extracted from them is committed to docs/reports/data/, exactly as the Phase-1
# audit JSON was -- so every number in a report is backed by a tracked file.
# experiments/logs/ (pre-registered hypotheses) IS tracked and must stay so.
checkpoints/
runs/
wandb/
*.pt
*.pth
*.ckpt

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Tooling ----------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
