{
  "data_dir": "data/chat",
  "seq_len": 256,
  "batch_size": 160,
  "mix": {
    "tinystories": 0.3,
    "soda": 0.4,
    "alpaca": 0.16,
    "dolly": 0.06,
    "oasst1": 0.02,
    "persona": 0.06
  },
  "d_model": 1024,
  "n_layers": 4,
  "vocab_size": 101,
  "arch": "twocomp_threshold",
  "beta": 0.5,
  "threshold": 1.0,
  "surrogate_alpha": 2.0,
  "w_init": 0.1,
  "thr_log_init": 0.0,
  "beta_slow": 0.95,
  "spread_tau": true,
  "tau_min": 3.0,
  "tau_max": 600.0,
  "lr": 0.0003,
  "weight_decay": 0.1,
  "beta1": 0.9,
  "beta2": 0.95,
  "grad_clip": 1.0,
  "warmup_steps": 100,
  "max_steps": 8000,
  "lr_schedule": "cosine",
  "lr_final_frac": 0.05,
  "dtype": "fp32",
  "fused": true,
  "cuda_graph": true,
  "device": "cuda",
  "seed": 0,
  "deterministic": false,
  "run_name": "chat-v2-anneal",
  "out_dir": "experiments/chat",
  "eval_every": 2000,
  "eval_batches": 30,
  "eval_batch_size": 48,
  "ckpt_every": 1000,
  "log_every": 500,
  "sample_every": 2000,
  "vocab_version": 1
}